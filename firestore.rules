rules_version = '2';

// Each signed-in user can read and write ONLY their own progress document,
// and the document may only hold the progress map. Everything else is denied.
// Paste this into Firebase Console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /datexia-lms/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['state'])
        && request.resource.data.state is map
        && request.resource.data.state.size() <= 300; // 158 tasks today; headroom for curriculum growth
    }
  }
}
